---
config:
  layout: elk
---
flowchart TB
 subgraph VIDEO_PIPE["🎬 Video Pipeline"]
        GStreamer["GStreamer / FFmpeg"]
        H264["HW Encoder (H.264/H.265)"]
        WebRTC_Prod["WebRTC Producer Agent"]
  end
 subgraph AI_PIPE["🧠 AI Inference Pipeline"]
        PreProc["Preprocessing"]
        YOLO["🚀 YOLO Detect"]
        Tracker["🎯 DeepSORT / ByteTrack"]
        JSON_Pack["📦 JSON Serializer"]
        MQTT_Client["📡 MQTT / WS Client"]
  end
 subgraph DOCKER_EDGE["Docker Container: AI & Streaming"]
    direction TB
        VIDEO_PIPE
        AI_PIPE
  end
 subgraph EDGE_LAYER["🏢 1. EDGE DEVICE (NVIDIA Jetson / IPC)"]
    direction TB
        CamInput((("📷 Camera Source<br>(RTSP/USB)")))
        DOCKER_EDGE
  end
 subgraph MEDIA_SERVER["🎥 Media Server (Azure VM)"]
        Janus["🦁 Janus / Mediasoup<br>(WebRTC Gateway)"]
        RecEngine["⏺️ Recording Engine"]
  end
 subgraph BACKEND["⚙️ Backend Control (Django)"]
        Auth["🛡️ Auth & Token Service"]
        REST["Django REST API"]
        Channels["⚡ Django Channels<br>(Async WebSocket)"]
        Logic["📊 Analytics & Logic"]
  end
 subgraph STORAGE["💾 Data Persistence"]
        Postgres[("🐘 PostgreSQL<br>(User, Logs, Metadata)")]
        Blob[("☁️ Azure Blob<br>(Video Files)")]
  end
 subgraph CLOUD_LAYER["☁️ 2. AZURE CLOUD INFRASTRUCTURE"]
    direction TB
        MEDIA_SERVER
        BACKEND
        STORAGE
  end
 subgraph VISUALIZER["📺 Realtime Visualizer"]
        VideoEL["HTML5 Video<br>(Background Layer)"]
        CanvasEL["🎨 Canvas Overlay<br>(Konva.js / Fabric.js)"]
  end
 subgraph BROWSER["User Browser"]
        Store["Global State<br>(Zustand/Redux)"]
        VISUALIZER
        Dashboard["📈 Dashboard & Charts"]
        WS_FE["🔌 WebSocket Client"]
        WebRTC_FE["🌐 WebRTC Consumer"]
  end
 subgraph FRONTEND_LAYER["💻 3. FRONTEND (Next.js PWA)"]
    direction TB
        BROWSER
  end
    CamInput --> GStreamer & PreProc
    GStreamer --> H264
    H264 --> WebRTC_Prod
    PreProc --> YOLO
    YOLO --> Tracker
    Tracker --> JSON_Pack
    JSON_Pack --> MQTT_Client
    WebRTC_Prod == "🔴 1. SRTP Stream (Low Latency)" ===> Janus
    Janus == "🔴 4. Video Relay" ===> WebRTC_FE
    WebRTC_FE ==> VideoEL
    MQTT_Client -- "🔵 2. Detection Data (JSON)" --> Channels
    Channels -- Process & Broadcast --> Logic
    Logic -- Save Stats --> Postgres
    Logic -- "🔵 4. Push Bbox/Stats" --> WS_FE
    WS_FE -- Draw Bbox --> CanvasEL
    WS_FE -- Update Charts --> Dashboard
    Store -- "🟠 1. Login & Get Token" --> Auth
    Auth -.-> Postgres
    Auth -- "🟠 2. Return Media Token" --> Store
    WebRTC_FE -. "🟠 3. Auth with Token" .-> Janus
    RecEngine -.-> Blob
    REST -. Get Playback URL .-> Blob
    CanvasEL -. Overlay Sync .-o VideoEL

     Janus:::mediaFill
     RecEngine:::mediaFill
     Auth:::backFill
     REST:::backFill
     Channels:::backFill
     Logic:::backFill
     Postgres:::dbFill
