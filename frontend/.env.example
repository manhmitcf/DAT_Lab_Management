# Backend API base URL (no trailing slash)
# - Unset/empty: use same-origin (Next.js proxies to localhost:8000)
# - For local backend: http://127.0.0.1:8000
# - For Azure: https://labmanagementbackend-hte4hyczd0fef4ah.eastasia-01.azurewebsites.net
# NEXT_PUBLIC_API_BASE=

# When using proxy (API_BASE empty), backend port (default 8000)
# NEXT_PUBLIC_API_PORT=8000
