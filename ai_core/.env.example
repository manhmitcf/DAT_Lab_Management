# WebSocket endpoint to push per-frame results to the frontend
RESULTS_WS_URL=wss://<YOUR_BACKEND_DOMAIN>/ws/persist/metadata/

# WebSocket endpoint to update mapping configuration
MAPPING_SETTINGS_WS_URL=wss://<YOUR_BACKEND_DOMAIN>/ws/settings/mapping/

# WebSocket endpoint to update counting configuration
COUNTING_SETTINGS_WS_URL=wss://<YOUR_BACKEND_DOMAIN>/ws/settings/counting/

# API Token for authorization (if any)
API_BEARER_TOKEN=your_secure_token_here
