# =========================================================
# DAT Lab Management - AI Core Environment Configuration
# =========================================================

# ---------------------------------------------------------
# WebSocket Endpoints (Backend API)
# ---------------------------------------------------------
# Endpoint to push per-frame results to the frontend
RESULTS_WS_URL=wss://[YOUR_BACKEND_DOMAIN]/ws/persist/metadata/

# Endpoint to update mapping configuration
MAPPING_SETTINGS_WS_URL=wss://[YOUR_BACKEND_DOMAIN]/ws/settings/mapping/

# Endpoint to update counting configuration
COUNTING_SETTINGS_WS_URL=wss://[YOUR_BACKEND_DOMAIN]/ws/settings/counting/

# Optional bearer token or API key for auth
API_BEARER_TOKEN=

# ---------------------------------------------------------
# WebRTC / DeepStream Configuration (Jetson to Azure)
# ---------------------------------------------------------
# 1. Connect to Azure Janus WebRTC
JANUS_SERVER_IP=[YOUR_JANUS_IP]
JANUS_UDP_PORT=8004

# 2. GStreamer Pipeline Configuration (DeepStream)

# [INPUT_VIDEO_SOURCE] Examples:
# For Live USB Camera: /dev/video0
# For MP4 Video File: /workspace/ai_core/tests/video.mp4
# For RTSP Camera IP: rtsp://admin:password@192.168.1.100/stream
INPUT_VIDEO_SOURCE=/dev/video0

VIDEO_BITRATE=1200000

# Tracker and Model Paths (Inside Docker Container `/workspace/ai_core`)
PGIE_CONFIG_PATH=deploy/DeepStream/config_infer_primary_yolox.txt
TRACKER_LIB_PATH=/workspace/ai_core/deploy/OCSort/cpp/build/libnvds_ocsort.so
TRACKER_CONFIG_PATH=deploy/DeepStream/config_tracker_ocsort.txt
