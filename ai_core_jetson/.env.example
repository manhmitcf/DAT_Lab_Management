# ==============================================================================
# AI Core Jetson - Environment Variables
# Copy this file to .env and fill in the values for your deployment.
# ==============================================================================

# --- Pipeline Configuration ---
# Source can be a local path (/vid/demo.mp4) or RTSP (rtsp://user:pass@ip:port/ch0)
VIDEO_SOURCE=./videos/demo.mp4
# Path to the nvinfer config file
CONFIG_INFER=config/config_infer.txt

# --- Janus Streaming Service ---
# Janus Gateway destination for the 720p H264 RTP stream.
JANUS_HOST=127.0.0.1
JANUS_PORT=5004

# --- Backend Integration ---
# WebSocket URL for publishing results (tracks, counts, map positions).
RESULTS_WS_URL=ws://192.168.1.100:8000/ws/results/

# --- Hot-Reload Settings ---
# WebSocket URLs for receiving live config updates from the Django backend.
MAPPING_SETTINGS_WS_URL=ws://192.168.1.100:8000/ws/mapping-settings/
COUNTING_SETTINGS_WS_URL=ws://192.168.1.100:8000/ws/counting-settings/

# --- Alert Thresholds ---
# Occupancy thresholds for triggering alerts.
ALERT_WARNING_THRESH=25
ALERT_CRITICAL_THRESH=50

# --- Authentication ---
# Bearer token for WebSocket authorization header.
API_BEARER_TOKEN=your-secret-token-here
